# CONFIGURACIÓN DEL SERVIDOR

# Puerto del servidor
PORT=5000

# ==========================================
# MONGODB ATLAS CLUSTER (Recomendado)
# ==========================================
# 1. Ve a https://www.mongodb.com/cloud/atlas
# 2. Crea una cuenta gratuita si no tienes una
# 3. Crea un cluster (el tier gratuito es suficiente)
# 4. Ve a Database Access y crea un usuario con password
# 5. Ve a Network Access y agrega tu IP (0.0.0.0/0 para desarrollo)
# 6. Click en "Connect" → "Connect your application"
# 7. Copia el connection string y reemplaza <password> con tu password real
#
# Formato del connection string:
# mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/<database>?retryWrites=true&w=majority
#
# EJEMPLO REAL (reemplaza con tus datos):
# MONGO_URL=mongodb+srv://admin:miPassword123@cluster0.ab12cd.mongodb.net/ecommerce?retryWrites=true&w=majority

MONGO_URL=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# ==========================================
# MONGODB LOCAL (Alternativa)
# ==========================================
# Si prefieres usar MongoDB local descomenta la siguiente línea:
# MONGO_URL=mongodb://localhost:27017/ecommerce

# ==========================================
# SEGURIDAD
# ==========================================
# JWT Secret - Usa una clave fuerte y única en producción
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_clave_secreta_jwt_cambiar_en_produccion_usar_clave_larga_y_segura

# Entorno de desarrollo/producción
NODE_ENV=development
